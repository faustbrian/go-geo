        "family": "domain-utilities",
        "secondary_capabilities": [
          "data-encoding",
          "database-and-storage",
          "protocols-and-schemas",
          "testing-and-conformance"
        ],
        "responsibility": "Provide immutable geospatial values, bounded geometry and geodesy operations, interoperable codecs, PostGIS mapping, and deterministic test helpers.",
        "non_goals": [
          "Provide geocoding, routing, address models, CRS transformation, a spatial database, or a replacement for PostGIS."
        ],
        "public_package_identifier": "geo",
        "primary_entry_packages": [
          "github.com/faustbrian/go-geo"
        ],
        "package_selection": {
          "github.com/faustbrian/go-geo": "Use for immutable coordinate, CRS, bounds, geometry, limits, and typed-error primitives.",
          "github.com/faustbrian/go-geo/adapter/gogeom": "Use only when converting between go-geo and github.com/twpayne/go-geom values.",
          "github.com/faustbrian/go-geo/geodesy": "Use for spherical and WGS84 ellipsoidal distance, bearing, destination, envelope, and bounded nearest calculations.",
          "github.com/faustbrian/go-geo/geohash": "Use for bounded geohash encoding, decoding, neighbor lookup, and covers.",
          "github.com/faustbrian/go-geo/geojson": "Use for bounded RFC 7946 geometry and feature encoding and decoding.",
          "github.com/faustbrian/go-geo/geotest": "Use in tests for authoritative vectors and tolerance-aware assertions.",
          "github.com/faustbrian/go-geo/postgis": "Use for caller-owned pgx/PostGIS geometry and geography mapping and reviewed spatial SQL fragments.",
          "github.com/faustbrian/go-geo/wkb": "Use for bounded WKB and EWKB encoding and decoding.",
          "github.com/faustbrian/go-geo/wkt": "Use for bounded WKT and EWKT encoding and decoding."
